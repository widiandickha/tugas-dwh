# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
venv/
.venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Environment variables & secrets
.env
*.env.local

# Dataset storage (Kaggle files are large, don't push raw data to Git)
data/raw/*
!data/raw/.gitkeep
data/staging/*
!data/staging/.gitkeep

# Local database files & logs
*.db
*.sqlite
*.sqlite3
logs/
*.log
UPDATE/
